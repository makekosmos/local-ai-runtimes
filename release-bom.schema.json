{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/makekosmos/local-ai-runtimes/release-bom.schema.json",
  "title": "Kosmos immutable runtime release BOM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "generated_at",
    "repository_commit",
    "release_tag",
    "signing_key_id",
    "runtimes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*-)?v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "platform",
          "architecture",
          "backend",
          "accelerator",
          "entrypoints",
          "archive",
          "source",
          "build",
          "licences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "platform": {
            "const": "windows"
          },
          "architecture": {
            "const": "x64"
          },
          "backend": {
            "enum": [
              "cpu",
              "vulkan"
            ]
          },
          "accelerator": {
            "enum": [
              "none",
              "vulkan"
            ]
          },
          "entrypoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "sha256",
              "size",
              "format",
              "files"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[^/\\\\]+\\.zip$"
              },
              "url": {
                "type": "string",
                "pattern": "^https://github\\.com/makekosmos/local-ai-runtimes/releases/download/[^/]+/[^/]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "format": {
                "const": "zip"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project",
              "version",
              "commit"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipe",
              "toolchain"
            ],
            "properties": {
              "recipe": {
                "type": "string",
                "minLength": 1
              },
              "toolchain": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "licences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "spdx",
                "path"
              ],
              "properties": {
                "spdx": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
